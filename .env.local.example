# URL de l'API backend, avec son préfixe de version.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Temps réel (boîte de réception, section 4.1) : laissés vides, la boîte de
# réception retombe sur le sondage (comportement d'avant ce lot). Mêmes
# valeurs que REVERB_APP_KEY/HOST/PORT/SCHEME côté backend (jamais secrètes).
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
